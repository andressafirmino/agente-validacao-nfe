# Api.RAG — projeto Vercel api-rag-auditoria-nfe (Root Directory = src/Api.RAG).
# Contexto Docker = esta pasta; props da raiz do repo em monorepo-root/.

FROM mcr.microsoft.com/dotnet/sdk:10.0.403 AS build
WORKDIR /src

COPY monorepo-root/global.json monorepo-root/Directory.Build.props monorepo-root/Directory.Packages.props ./
COPY Api.RAG.csproj ./src/Api.RAG/
COPY . ./src/Api.RAG/

RUN dotnet restore src/Api.RAG/Api.RAG.csproj
RUN dotnet publish src/Api.RAG/Api.RAG.csproj -c Release -o /app/publish --no-restore -p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0.14 AS final
WORKDIR /app
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080

COPY --from=build --chown=$APP_UID /app/publish .

USER $APP_UID
ENTRYPOINT ["/bin/sh", "-c", "ASPNETCORE_HTTP_PORTS=\"${PORT:-8080}\" exec dotnet Api.RAG.dll"]
